// 4) data (fine for this size; for >100k nodes use CALL { ... } IN TRANSACTIONS)
MATCH (n) DETACH DELETE n;

// 5) verify - expect: no constraints, no indexes except the default LOOKUP indexes, 0 nodes
SHOW CONSTRAINTS;
SHOW INDEXES;
MATCH (n) RETURN count(n) AS nodesLeft;
